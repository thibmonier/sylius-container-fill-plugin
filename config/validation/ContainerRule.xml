<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd">

    <class name="Tmonier\SyliusContainerFillPlugin\Entity\ContainerRule">
        <constraint name="Tmonier\SyliusContainerFillPlugin\Validator\ValidContainerRule">
            <option name="groups">sylius</option>
        </constraint>
        <property name="name">
            <constraint name="NotBlank">
                <option name="message">tmonier_container_fill.container_rule.name.not_blank</option>
                <option name="groups">sylius</option>
            </constraint>
            <constraint name="Length">
                <option name="max">255</option>
                <option name="groups">sylius</option>
            </constraint>
        </property>
        <property name="channel">
            <constraint name="NotNull">
                <option name="message">tmonier_container_fill.container_rule.channel.not_null</option>
                <option name="groups">sylius</option>
            </constraint>
        </property>
        <property name="containerTypes">
            <constraint name="Count">
                <option name="min">1</option>
                <option name="minMessage">tmonier_container_fill.container_rule.container_types.min</option>
                <option name="groups">sylius</option>
            </constraint>
        </property>
    </class>
</constraint-mapping>
