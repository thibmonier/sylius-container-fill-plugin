{# Rendered with \Tmonier\SyliusContainerFillPlugin\Twig\Component\ContainerGaugeComponent #}
{% set report = this.report %}
<div {{ attributes }}>
    {% if report.hasRules or report.lineViolations is not empty %}
        <style>
            .tmonier-cf-bar-fill { transition: none; }
            @media (prefers-reduced-motion: no-preference) { .tmonier-cf-bar-fill { transition: width .3s ease-out; } }
        </style>
        <div class="card mb-4" {{ sylius_test_html_attribute('tmonier-container-fill-gauge') }}>
            <div class="card-body">
                <h2 class="h5 mb-3">{{ 'tmonier_container_fill.ui.load_plan'|trans }}</h2>

                <div aria-live="polite" {{ sylius_test_html_attribute('tmonier-container-fill-status') }}>
                    {% if report.satisfied %}
                        <p class="mb-2 text-success fw-semibold">{{ ux_icon('tabler:circle-check', {'class': 'icon', 'aria-hidden': 'true'}) }} {{ 'tmonier_container_fill.ui.rules_met'|trans }}</p>
                    {% else %}
                        <p class="mb-2 text-danger fw-semibold">{{ ux_icon('tabler:alert-triangle', {'class': 'icon', 'aria-hidden': 'true'}) }} {{ 'tmonier_container_fill.ui.rules_not_met'|trans }}</p>
                    {% endif %}
                </div>

                {# Load plan: each line planned once, by its most specific rule. #}
                {% for entry in report.plan %}
                    {% set result = entry.result %}
                    {% set blocking = report.outcomes|filter(candidate => candidate.rule.id == entry.rule.id)|first %}
                    {% set required = blocking ? blocking.rule.requiredFill : entry.rule.requiredFill %}
                    <div class="mb-3" {{ sylius_test_html_attribute('tmonier-container-fill-plan', loop.index0) }}>
                        <div class="small text-body-secondary mb-1">
                            {{ entry.rule.name }} ·
                            {{ 'tmonier_container_fill.ui.container_count'|trans({'%count%': result.containerCount, '%type%': result.container.name}) }}
                            {% if result.container.indicative %}<span class="badge text-bg-light border">{{ 'tmonier_container_fill.ui.indicative'|trans }}</span>{% endif %}
                        </div>

                        {# Identical full containers are summarised in one line, the others listed. #}
                        {% set fulls = result.containers|filter(container => container.full and container.percent >= 100 and not container.overloaded) %}
                        {% set grouped = fulls|length > 1 %}
                        {% if grouped %}
                            {% set label = 'tmonier_container_fill.ui.full_containers'|trans({'%count%': fulls|length, '%total%': result.containerCount, '%type%': result.container.name}) %}
                            <div class="mb-2" {{ sylius_test_html_attribute('tmonier-container-fill-full-group', fulls|length) }}>
                                <div class="d-flex justify-content-between small">
                                    <span>{{ label }}</span>
                                    <span class="fw-semibold">{{ 'tmonier_container_fill.ui.status_ok'|trans }}</span>
                                </div>
                                <div role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100" aria-valuetext="{{ label }}" aria-label="{{ label }}">
                                    <svg viewBox="0 0 100 6" width="100%" height="12" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                                        <rect x="0" y="0" width="100" height="6" rx="1" fill="#2fb344"></rect>
                                    </svg>
                                </div>
                            </div>
                        {% endif %}
                        {% for container in result.containers|filter(container => not grouped or container not in fulls) %}
                            {% set percent = container.percent %}
                            {% set shown = min(100, percent) %}
                            {% set ok = container.full or (required is not null and container.ratio >= required - 0.000001) or required is null %}
                            {% set label = 'tmonier_container_fill.ui.container_fill'|trans({'%index%': container.index, '%count%': result.containerCount, '%percent%': percent, '%binding%': ('tmonier_container_fill.binding.' ~ container.binding.value)|trans}) %}
                            <div class="mb-2" {{ sylius_test_html_attribute('tmonier-container-fill-container', container.index) }}>
                                <div class="d-flex justify-content-between small">
                                    <span>{{ label }}</span>
                                    <span class="fw-semibold">{{ ok ? 'tmonier_container_fill.ui.status_ok'|trans : 'tmonier_container_fill.ui.status_missing'|trans }}</span>
                                </div>
                                <div role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ shown }}" aria-valuetext="{{ label }}" aria-label="{{ label }}">
                                    <svg viewBox="0 0 100 6" width="100%" height="12" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                                        <rect x="0" y="0" width="100" height="6" rx="1" fill="#e9ecef"></rect>
                                        <rect class="tmonier-cf-bar-fill" x="0" y="0" width="{{ shown }}" height="6" rx="1" fill="{{ container.overloaded ? '#d63939' : (ok ? '#2fb344' : '#f59f00') }}"></rect>
                                        {% if required is not null and required < 1 %}
                                            <line x1="{{ required * 100 }}" y1="0" x2="{{ required * 100 }}" y2="6" stroke="#1d273b" stroke-width="0.6"></line>
                                        {% endif %}
                                    </svg>
                                </div>
                                {% if result.container.slots > 1 %}
                                    {% set slots = result.container.slots %}
                                    {% set used = container.slotRatio * slots %}
                                    {% set columns = (slots / 2)|round(0, 'ceil') %}
                                    <svg viewBox="0 0 {{ columns * 6 }} 12" width="100%" height="28" class="mt-1" aria-hidden="true" focusable="false" {{ sylius_test_html_attribute('tmonier-container-fill-places') }}>
                                        {% for place in 0..(slots - 1) %}
                                            {% set column = (place / 2)|round(0, 'floor') %}
                                            {% set row = place % 2 %}
                                            {% set filled = max(0, min(1, used - place)) %}
                                            <rect x="{{ column * 6 + 0.5 }}" y="{{ row * 6 + 0.5 }}" width="5" height="5" fill="#ffffff" stroke="#adb5bd" stroke-width="0.3"></rect>
                                            {% if filled > 0 %}<rect x="{{ column * 6 + 0.5 }}" y="{{ row * 6 + 0.5 }}" width="{{ 5 * filled }}" height="5" fill="#206bc4"></rect>{% endif %}
                                        {% endfor %}
                                    </svg>
                                    <div class="small text-body-secondary">{{ 'tmonier_container_fill.ui.places_used'|trans({'%used%': used|round(1), '%slots%': slots}) }}</div>
                                {% endif %}
                                {% if result.layerMode and container.layers is not empty %}
                                    {% include '@TmonierSyliusContainerFillPlugin/shop/_stack.html.twig' with { container: container, spec: result.container } only %}
                                {% endif %}
                                {% if container.volumeExceeded %}
                                    <div class="small text-body-secondary" {{ sylius_test_html_attribute('tmonier-container-fill-volume-warning', container.index) }}>{{ ux_icon('tabler:info-circle', {'class': 'icon', 'aria-hidden': 'true'}) }} {{ 'tmonier_container_fill.ui.volume_warning'|trans({'%volume%': (container.volumeRatio * 100)|round}) }}</div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}

                {# Rules: every applicable rule is checked on all the lines of its scope. #}
                {% for outcome in report.outcomes %}
                    {% set result = outcome.result %}
                    <div class="mb-2" {{ sylius_test_html_attribute('tmonier-container-fill-rule', loop.index0) }}>
                        {% if outcome.satisfied %}
                            <div class="small text-success">{{ ux_icon('tabler:check', {'class': 'icon', 'aria-hidden': 'true'}) }} {{ outcome.rule.name }} · {{ 'tmonier_container_fill.ui.rule_met'|trans }}</div>
                        {% else %}
                            <div class="small fw-semibold">{{ outcome.rule.name }}</div>
                            {% if not report.isPlanned(outcome) %}
                                {# The rule also covers lines planned by a more specific rule: its violations number its own containers. #}
                                <div class="small text-body-secondary" {{ sylius_test_html_attribute('tmonier-container-fill-rule-containers', loop.index0) }}>
                                    {% set required = outcome.rule.requiredFill %}
                                    {% set short = result.containers|filter(container => container.overloaded or (not container.full and required is not null and container.ratio < required - 0.000001)) %}
                                    {{ 'tmonier_container_fill.ui.rule_containers'|trans({'%count%': result.containerCount, '%type%': result.container.name}) }}
                                    {% for container in short|slice(0, 5) %}{{ 'tmonier_container_fill.ui.container_fill'|trans({'%index%': container.index, '%count%': result.containerCount, '%percent%': container.percent, '%binding%': ('tmonier_container_fill.binding.' ~ container.binding.value)|trans}) }}{% if not loop.last %} · {% endif %}{% endfor %}{% if short|length > 5 %} · {{ 'tmonier_container_fill.ui.and_more'|trans({'%count%': short|length - 5}) }}{% endif %}
                                </div>
                            {% endif %}
                        {% if not outcome.satisfied %}
                            <ul class="small text-danger ps-3 mb-2" {{ sylius_test_html_attribute('tmonier-container-fill-violations') }}>
                                {% for violation in outcome.violations|slice(0, 5) %}
                                    <li>{{ ('tmonier_container_fill.violation.' ~ violation.code)|trans(violation.translationParameters, 'validators') }}</li>
                                {% endfor %}
                                {% if outcome.violations|length > 5 %}<li>{{ 'tmonier_container_fill.ui.and_more'|trans({'%count%': outcome.violations|length - 5}) }}</li>{% endif %}
                            </ul>
                        {% endif %}

                        {% set suggestion = outcome.suggestion %}
                        {% if suggestion is not null %}
                            {% set parameters = {'%product%': suggestion.label, '%units%': suggestion.addUnits, '%cases%': suggestion.addCases, '%index%': suggestion.containerIndex, '%type%': result.container.name} %}
                            <p class="small mb-2" {{ sylius_test_html_attribute('tmonier-container-fill-suggestion') }}>
                                {% if suggestion.action == 'round_to_multiple' %}
                                    {{ 'tmonier_container_fill.suggestion.round_to_multiple'|trans(parameters) }}
                                {% elseif suggestion.binding.value == 'slots' %}
                                    {{ (suggestion.addCases is not null ? 'tmonier_container_fill.suggestion.complete_cases' : 'tmonier_container_fill.suggestion.complete_units')|trans(parameters) }}
                                {% else %}
                                    {{ ('tmonier_container_fill.suggestion.complete_' ~ suggestion.binding.value)|trans(parameters) }}
                                {% endif %}
                            </p>
                            <button type="button" class="btn btn-sm btn-outline-primary mb-2"
                                    data-action="live#action"
                                    data-live-action-param="complete"
                                    data-live-rule-param="{{ loop.index0 }}"
                                    {{ sylius_test_html_attribute('tmonier-container-fill-complete', loop.index0) }}
                            >
                                {{ 'tmonier_container_fill.ui.add_units'|trans({'%units%': suggestion.addUnits, '%product%': suggestion.label}) }}
                            </button>
                        {% endif %}
                        {% endif %}
                    </div>
                {% endfor %}

                {% if report.lineViolations is not empty %}
                    <ul class="small text-danger ps-3 mb-2" {{ sylius_test_html_attribute('tmonier-container-fill-line-violations') }}>
                        {% for violation in report.lineViolations %}
                            <li>{{ ('tmonier_container_fill.violation.' ~ violation.code)|trans(violation.translationParameters, 'validators') }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% for rounding in this.layerRoundings %}
                    <button type="button" class="btn btn-sm btn-outline-secondary me-1 mb-1"
                            data-action="live#action"
                            data-live-action-param="roundToLayer"
                            data-live-variant-param="{{ rounding.key }}"
                            {{ sylius_test_html_attribute('tmonier-container-fill-round-layer', rounding.key) }}
                    >
                        {{ 'tmonier_container_fill.ui.round_to_layer'|trans({'%product%': rounding.label, '%quantity%': rounding.target}) }}
                    </button>
                {% endfor %}

                <p class="small text-body-secondary mt-2 mb-0">{{ 'tmonier_container_fill.ui.plan_disclaimer'|trans }}</p>
            </div>
        </div>
    {% endif %}
</div>
