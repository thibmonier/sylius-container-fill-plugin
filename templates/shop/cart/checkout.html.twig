{# Replaces the core checkout button of the cart: disabled, with the reason, while the fill rules are not met. #}
{% set cart = hookable_metadata.context.cart|default(null) ?? hookable_metadata.context.form.vars.data|default(null) %}
{% set report = tmonier_container_fill_cart_gauge_enabled() ? tmonier_container_fill_report(cart) : null %}
<div class="d-grid">
    {% if report is not null and not report.satisfied %}
        <button type="submit" class="btn btn-primary" disabled aria-describedby="tmonier-container-fill-checkout-reason" {{ sylius_test_html_attribute('cart-checkout-button') }}>
            {{ 'sylius.ui.checkout'|trans }}
        </button>
        <p id="tmonier-container-fill-checkout-reason" class="small text-danger mt-2 mb-0" {{ sylius_test_html_attribute('tmonier-container-fill-checkout-reason') }}>
            {{ 'tmonier_container_fill.ui.checkout_disabled'|trans }}
        </p>
    {% else %}
        <button type="submit" class="btn btn-primary" {{ sylius_test_html_attribute('cart-checkout-button') }}>
            {{ 'sylius.ui.checkout'|trans }}
        </button>
    {% endif %}
</div>
