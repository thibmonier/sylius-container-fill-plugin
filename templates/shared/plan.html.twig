{# plan: CartFillReport::toArray() (snapshot or computed). "plan": containers, each line planned once; "rules": every applicable rule. Snapshots without "plan" show the containers per rule. #}
{% set entries = plan.plan is defined ? plan.plan : plan.rules %}
{% for entry in entries %}
    <div class="mb-3" {{ sylius_test_html_attribute('tmonier-container-fill-plan-rule', loop.index0) }}>
        <div class="fw-semibold">
            {{ entry.rule.name }} ·
            {{ 'tmonier_container_fill.ui.container_count'|trans({'%count%': entry.containerCount, '%type%': entry.containerType.name}) }}
            {% if entry.containerType.indicative %}<span class="badge bg-yellow-lt ms-1">{{ 'tmonier_container_fill.ui.indicative'|trans }}</span>{% endif %}
        </div>
        <ul class="list-unstyled mb-1 small">
            {% for container in entry.containers %}
                <li>
                    {{ 'tmonier_container_fill.ui.container_fill'|trans({'%index%': container.index, '%count%': entry.containerCount, '%percent%': container.percent, '%binding%': ('tmonier_container_fill.binding.' ~ container.binding)|trans}) }}
                    <span class="text-secondary">({{ container.volume is null ? 'tmonier_container_fill.ui.dimensions_detail_no_volume'|trans({'%slots%': container.slots, '%weight%': container.weight}) : 'tmonier_container_fill.ui.dimensions_detail'|trans({'%slots%': container.slots, '%weight%': container.weight, '%volume%': container.volume}) }})</span>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endfor %}
{% for rule in plan.rules %}
    <div class="small mb-1" {{ sylius_test_html_attribute('tmonier-container-fill-plan-check', loop.index0) }}>
        {% if rule.satisfied %}
            <span class="text-success">{{ rule.rule.name }} · {{ 'tmonier_container_fill.ui.rule_met'|trans }}</span>
        {% else %}
            <span class="fw-semibold">{{ rule.rule.name }}</span>
            {% if not rule.planned|default(true) %}
                <div class="text-secondary" {{ sylius_test_html_attribute('tmonier-container-fill-plan-rule-containers', loop.index0) }}>
                    {{ 'tmonier_container_fill.ui.rule_containers'|trans({'%count%': rule.containerCount, '%type%': rule.containerType.name}) }}
                    {% set required = rule.rule.mode == 'full_only' ? 100 : (rule.rule.mode == 'min_fill_percent' ? rule.rule.threshold : null) %}
                    {% set short = rule.containers|filter(container => container.percent > 100 or (not container.full and required is not null and container.percent < required)) %}
                    {% for container in short|slice(0, 5) %}{{ 'tmonier_container_fill.ui.container_fill'|trans({'%index%': container.index, '%count%': rule.containerCount, '%percent%': container.percent, '%binding%': ('tmonier_container_fill.binding.' ~ container.binding)|trans}) }}{% if not loop.last %} · {% endif %}{% endfor %}{% if short|length > 5 %} · {{ 'tmonier_container_fill.ui.and_more'|trans({'%count%': short|length - 5}) }}{% endif %}
                </div>
            {% endif %}
            <ul class="text-danger mb-0">
                {% for violation in rule.violations %}<li>{% include '@TmonierSyliusContainerFillPlugin/shared/violation.html.twig' %}</li>{% endfor %}
            </ul>
        {% endif %}
    </div>
{% endfor %}
{% if plan.lineViolations is not empty %}
    <ul class="text-danger small mb-0">
        {% for violation in plan.lineViolations %}<li>{% include '@TmonierSyliusContainerFillPlugin/shared/violation.html.twig' %}</li>{% endfor %}
    </ul>
{% endif %}
